{
  "pipeline": [
    {
      "$match": {
        "sla.within": {
          "$ne": null
        }
      }
    },
    {
      "$group": {
        "_id": "$classification.category",
        "cases": {
          "$sum": 1
        },
        "within": {
          "$sum": {
            "$cond": [
              "$sla.within",
              1,
              0
            ]
          }
        },
        "avg_res_h": {
          "$avg": "$metrics.resolution_hours"
        }
      }
    },
    {
      "$project": {
        "cases": 1,
        "avg_res_h": {
          "$round": [
            "$avg_res_h",
            2
          ]
        },
        "sla_compliance_pct": {
          "$round": [
            {
              "$multiply": [
                {
                  "$divide": [
                    "$within",
                    "$cases"
                  ]
                },
                100
              ]
            },
            2
          ]
        }
      }
    },
    {
      "$sort": {
        "cases": -1
      }
    }
  ],
